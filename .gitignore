# ===========================================
# CKA Study App - Professional .gitignore
# Vite + React + TypeScript + Tailwind + Capacitor (Android)
# ===========================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# TypeScript
*.tsbuildinfo

# Testing
/coverage/

# Misc
*.bak
*.tmp

# ===========================================
# Android / Capacitor specific
# (core android/ folder is tracked; only build artifacts ignored)
# ===========================================

# Android build artifacts (handled by android/.gitignore too, but explicit at root)
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/app/.cxx/
android/.idea/
android/captures/
android/.externalNativeBuild/
android/*.apk
android/*.aab
android/*.ap_

# Generated by Capacitor sync (regenerated from web build)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Gradle wrapper (keep the jar and properties, but ignore caches)
# Note: gradle/wrapper/ is intentionally tracked for reproducible builds

# Capacitor iOS (if added later)
ios/App/build/
ios/App/Pods/
*.xcworkspace/
*.xcodeproj/

# Keystore / signing (never commit real keys)
*.jks
*.keystore
upload-keystore.jks

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
